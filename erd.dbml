// Library Management System ERD (DBML for dbdiagram.io)

Table authors {
  author_id integer [pk, increment]
  first_name text [not null]
  last_name text [not null]
  country text
}

Table categories {
  category_id integer [pk, increment]
  name text [not null, unique]
}

Table books {
  book_id integer [pk, increment]
  title text [not null]
  isbn text [not null, unique]
  published_year integer
  copies_available integer [not null, default: 1]
  category_id integer [not null]
}

Table book_authors {
  book_id integer [not null]
  author_id integer [not null]
  indexes {
    (book_id, author_id) [pk]
  }
}

Table members {
  member_id integer [pk, increment]
  full_name text [not null]
  email text [not null, unique]
  joined_date text [not null]
}

Table loans {
  loan_id integer [pk, increment]
  book_id integer [not null]
  member_id integer [not null]
  loan_date text [not null]
  due_date text [not null]
  return_date text
}

Ref: books.category_id > categories.category_id
Ref: book_authors.book_id > books.book_id
Ref: book_authors.author_id > authors.author_id
Ref: loans.book_id > books.book_id
Ref: loans.member_id > members.member_id
